rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Reusable Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Pure token-only admin check safe for list queries (no get/exists reads)
    function isPrimaryAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'arigyewisdom7@gmail.com';
    }

    function isAdmin() {
      return isPrimaryAdmin() || (
        isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReferralCodeFormat(code) {
      return code is string && code.size() >= 6 && code.size() <= 24 && code.matches('^[A-Z0-9\\-]+$');
    }

    function existingReferralsCount() {
      return ('referralsCount' in existing()) ? existing().referralsCount : 0;
    }

    function existingReferralCreditsEarned() {
      return ('referralCreditsEarned' in existing()) ? existing().referralCreditsEarned : 0;
    }

    function existingInviteeBonusApplied() {
      return ('inviteeBonusApplied' in existing()) ? existing().inviteeBonusApplied : false;
    }

    function existingLastClaimedReferralId() {
      return ('lastClaimedReferralId' in existing()) ? existing().lastClaimedReferralId : '';
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints
    // -------------------------------------------------------------------------
    function isValidUserPublic(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'bio', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoUrl' in data) || (
          data.photoUrl is string
          && data.photoUrl.size() <= 150000
          && data.photoUrl.matches('^(|https://.*|data:image/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=]+)$')
        ))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'email', 'country', 'phone', 'preferredChannel',
          'projectUpdatesOptIn', 'marketingOptIn', 'createdAt', 'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 200
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('preferredChannel' in data) || data.preferredChannel in ['email', 'whatsapp', 'phone', 'google_meet'])
        && (!('projectUpdatesOptIn' in data) || data.projectUpdatesOptIn is bool)
        && (!('marketingOptIn' in data) || data.marketingOptIn is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectInquiry(data, inquiryId) {
      return data.keys().hasAll([
          'inquiryId', 'authorId', 'name', 'email', 'country', 'dialCode',
          'phone', 'service', 'budget', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'inquiryId', 'authorId', 'name', 'email', 'country', 'dialCode',
          'phone', 'company', 'service', 'budget', 'message', 'status', 'createdAt', 'updatedAt'
        ])
        && data.inquiryId is string
        && isValidId(data.inquiryId)
        && data.inquiryId == inquiryId
        && data.authorId is string
        && isValidId(data.authorId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.country is string && data.country.size() >= 2 && data.country.size() <= 100
        && data.dialCode is string && data.dialCode.size() >= 1 && data.dialCode.size() <= 16
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        && (!('company' in data) || (data.company is string && data.company.size() <= 120))
        && data['service'] is string && data['service'].size() >= 2 && data['service'].size() <= 120
        && data.budget is string && data.budget.size() >= 2 && data.budget.size() <= 80
        && data.message is string && data.message.size() >= 15 && data.message.size() <= 3000
        && data.status in ['submitted', 'reviewed', 'in_progress', 'completed', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data, notificationId) {
      return data.keys().hasAll([
          'notificationId', 'recipientId', 'senderEmail', 'type',
          'title', 'body', 'isRead', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'notificationId', 'recipientId', 'senderEmail', 'type',
          'title', 'body', 'inquiryId', 'projectStatus', 'linkRoute', 'targetId',
          'isRead', 'createdAt', 'updatedAt'
        ])
        && data.notificationId is string
        && isValidId(data.notificationId)
        && data.notificationId == notificationId
        && data.recipientId is string
        && isValidId(data.recipientId)
        && data.senderEmail is string && data.senderEmail.size() >= 3 && data.senderEmail.size() <= 200
        && data.type in ['status_update', 'admin_message', 'movie_release', 'blog_upcoming']
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.body is string && data.body.size() >= 2 && data.body.size() <= 2000
        && (!('inquiryId' in data) || (data.inquiryId is string && data.inquiryId.size() <= 128))
        && (!('projectStatus' in data) || (data.projectStatus is string && data.projectStatus.size() <= 40))
        && (!('linkRoute' in data) || data.linkRoute in ['dashboard', 'movies', 'blog'])
        && (!('targetId' in data) || (data.targetId is string && data.targetId.size() <= 128))
        && data.isRead is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectMilestone(data, inquiryId, milestoneId) {
      return data.keys().hasAll([
          'milestoneId', 'inquiryId', 'authorId', 'title', 'phase',
          'summary', 'status', 'progress', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'milestoneId', 'inquiryId', 'authorId', 'title', 'phase',
          'summary', 'dueDate', 'status', 'progress', 'sortOrder', 'createdAt', 'updatedAt'
        ])
        && data.milestoneId is string
        && isValidId(data.milestoneId)
        && data.milestoneId == milestoneId
        && data.inquiryId is string
        && isValidId(data.inquiryId)
        && data.inquiryId == inquiryId
        && data.authorId is string
        && isValidId(data.authorId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.phase is string && data.phase.size() >= 2 && data.phase.size() <= 60
        && data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 600
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 40))
        && data.status in ['pending', 'in_progress', 'completed']
        && data.progress is int && data.progress >= 0 && data.progress <= 100
        && data.sortOrder is int && data.sortOrder >= 1 && data.sortOrder <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectMessage(data, inquiryId, messageId) {
      return data.keys().hasAll([
          'messageId', 'inquiryId', 'authorId', 'senderId',
          'senderRole', 'senderName', 'body', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'messageId', 'inquiryId', 'authorId', 'senderId',
          'senderRole', 'senderName', 'body', 'createdAt', 'updatedAt'
        ])
        && data.messageId is string && isValidId(data.messageId) && data.messageId == messageId
        && data.inquiryId is string && isValidId(data.inquiryId) && data.inquiryId == inquiryId
        && data.authorId is string && isValidId(data.authorId)
        && data.senderId is string && isValidId(data.senderId)
        && data.senderRole in ['client', 'admin']
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 100
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectDeliverable(data, inquiryId, deliverableId) {
      return data.keys().hasAll([
          'deliverableId', 'inquiryId', 'authorId', 'title',
          'category', 'url', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'deliverableId', 'inquiryId', 'authorId', 'title',
          'category', 'url', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.deliverableId is string && isValidId(data.deliverableId) && data.deliverableId == deliverableId
        && data.inquiryId is string && isValidId(data.inquiryId) && data.inquiryId == inquiryId
        && data.authorId is string && isValidId(data.authorId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.category in ['figma', 'staging', 'repository', 'production', 'document']
        && data.url is string && data.url.size() >= 8 && data.url.size() <= 500 && data.url.matches('^https://.*')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProjectInvoice(data, inquiryId, invoiceId) {
      return data.keys().hasAll([
          'invoiceId', 'inquiryId', 'authorId', 'title', 'phase',
          'amountUsd', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'invoiceId', 'inquiryId', 'authorId', 'title', 'phase',
          'amountUsd', 'dueDate', 'status', 'paymentMethod', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.invoiceId is string && isValidId(data.invoiceId) && data.invoiceId == invoiceId
        && data.inquiryId is string && isValidId(data.inquiryId) && data.inquiryId == inquiryId
        && data.authorId is string && isValidId(data.authorId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.phase is string && data.phase.size() >= 2 && data.phase.size() <= 60
        && data.amountUsd is int && data.amountUsd >= 1 && data.amountUsd <= 1000000
        && (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 40))
        && data.status in ['pending', 'paid', 'overdue']
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 80))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDiscoveryBooking(data, bookingId) {
      return data.keys().hasAll([
          'bookingId', 'authorId', 'name', 'email', 'timezone',
          'slotDate', 'slotTimeEat', 'channel', 'topic', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'bookingId', 'authorId', 'name', 'email', 'timezone',
          'slotDate', 'slotTimeEat', 'channel', 'topic', 'status', 'createdAt', 'updatedAt'
        ])
        && data.bookingId is string && isValidId(data.bookingId) && data.bookingId == bookingId
        && data.authorId is string && isValidId(data.authorId)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.timezone is string && data.timezone.size() >= 2 && data.timezone.size() <= 80
        && data.slotDate is string && data.slotDate.size() >= 4 && data.slotDate.size() <= 30
        && data.slotTimeEat is string && data.slotTimeEat.size() >= 4 && data.slotTimeEat.size() <= 30
        && data.channel in ['google_meet', 'whatsapp_call', 'kabale_studio']
        && data.topic is string && data.topic.size() >= 5 && data.topic.size() <= 600
        && data.status in ['requested', 'confirmed', 'completed', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioProject(data, projectId) {
      return data.keys().hasAll([
          'projectId', 'title', 'sector', 'region', 'timeline', 'clientType',
          'deliverableType', 'previewUrl', 'previewKind', 'problem', 'solution',
          'architectureNotes', 'metric1Value', 'metric1Label', 'metric2Value',
          'metric2Label', 'metric3Value', 'metric3Label', 'stackSummary',
          'featured', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'projectId', 'title', 'sector', 'region', 'timeline', 'clientType',
          'deliverableType', 'previewUrl', 'previewKind', 'problem', 'solution',
          'architectureNotes', 'metric1Value', 'metric1Label', 'metric2Value',
          'metric2Label', 'metric3Value', 'metric3Label', 'stackSummary',
          'featured', 'createdAt', 'updatedAt'
        ])
        && data.projectId is string && isValidId(data.projectId) && data.projectId == projectId
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 120
        && data.sector is string && data.sector.size() >= 2 && data.sector.size() <= 40
        && data.region is string && data.region.size() >= 2 && data.region.size() <= 80
        && data.timeline is string && data.timeline.size() >= 2 && data.timeline.size() <= 80
        && data.clientType is string && data.clientType.size() >= 2 && data.clientType.size() <= 80
        && data.deliverableType is string && data.deliverableType.size() >= 2 && data.deliverableType.size() <= 80
        && data.previewUrl is string && data.previewUrl.size() >= 4 && data.previewUrl.size() <= 120
        && data.previewKind in [
          'fintech', 'telehealth', 'logistics', 'agritech', 'ecommerce', 'edtech',
          'cleantech', 'saas', 'pharma', 'hospitality', 'security', 'govtech'
        ]
        && data.problem is string && data.problem.size() >= 10 && data.problem.size() <= 800
        && data.solution is string && data.solution.size() >= 10 && data.solution.size() <= 800
        && data.architectureNotes is string && data.architectureNotes.size() >= 5 && data.architectureNotes.size() <= 500
        && data.metric1Value is string && data.metric1Value.size() >= 1 && data.metric1Value.size() <= 30
        && data.metric1Label is string && data.metric1Label.size() >= 2 && data.metric1Label.size() <= 60
        && data.metric2Value is string && data.metric2Value.size() >= 1 && data.metric2Value.size() <= 30
        && data.metric2Label is string && data.metric2Label.size() >= 2 && data.metric2Label.size() <= 60
        && data.metric3Value is string && data.metric3Value.size() >= 1 && data.metric3Value.size() <= 30
        && data.metric3Label is string && data.metric3Label.size() >= 2 && data.metric3Label.size() <= 60
        && data.stackSummary is string && data.stackSummary.size() >= 3 && data.stackSummary.size() <= 160
        && data.featured is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlogPost(data, postId) {
      return data.keys().hasAll([
          'postId', 'slug', 'title', 'excerpt', 'category', 'authorName',
          'authorRole', 'publishedDate', 'readTimeMinutes', 'featured',
          'coverImage', 'stackTags', 'keyTakeaways', 'section1Heading',
          'section1Body', 'section2Heading', 'section2Body', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'postId', 'slug', 'title', 'excerpt', 'category', 'authorName',
          'authorRole', 'publishedDate', 'readTimeMinutes', 'featured',
          'coverImage', 'stackTags', 'keyTakeaways', 'section1Heading',
          'section1Body', 'section2Heading', 'section2Body', 'section3Heading',
          'section3Body', 'calloutQuote', 'codeFilename', 'codeLanguage',
          'codeSnippet', 'publishStatus', 'scheduledDate', 'createdAt', 'updatedAt'
        ])
        && data.postId is string && isValidId(data.postId) && data.postId == postId
        && data.slug is string && data.slug.size() >= 3 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.title is string && data.title.size() >= 5 && data.title.size() <= 160
        && data.excerpt is string && data.excerpt.size() >= 15 && data.excerpt.size() <= 400
        && data.category in ['Architecture', 'Cloud & DevOps', 'Mobile & Offline', 'Security', 'Fintech Systems']
        && data.authorName is string && data.authorName.size() >= 2 && data.authorName.size() <= 80
        && data.authorRole is string && data.authorRole.size() >= 2 && data.authorRole.size() <= 80
        && data.publishedDate is string && data.publishedDate.size() >= 4 && data.publishedDate.size() <= 40
        && data.readTimeMinutes is int && data.readTimeMinutes >= 1 && data.readTimeMinutes <= 60
        && data.featured is bool
        && data.coverImage is string && data.coverImage.size() >= 4 && data.coverImage.size() <= 300
        && data.stackTags is string && data.stackTags.size() >= 2 && data.stackTags.size() <= 200
        && data.keyTakeaways is string && data.keyTakeaways.size() >= 10 && data.keyTakeaways.size() <= 1000
        && data.section1Heading is string && data.section1Heading.size() >= 3 && data.section1Heading.size() <= 140
        && data.section1Body is string && data.section1Body.size() >= 20 && data.section1Body.size() <= 4000
        && data.section2Heading is string && data.section2Heading.size() >= 3 && data.section2Heading.size() <= 140
        && data.section2Body is string && data.section2Body.size() >= 20 && data.section2Body.size() <= 4000
        && (!('section3Heading' in data) || (data.section3Heading is string && data.section3Heading.size() <= 140))
        && (!('section3Body' in data) || (data.section3Body is string && data.section3Body.size() <= 4000))
        && (!('calloutQuote' in data) || (data.calloutQuote is string && data.calloutQuote.size() <= 500))
        && (!('codeFilename' in data) || (data.codeFilename is string && data.codeFilename.size() <= 80))
        && (!('codeLanguage' in data) || (data.codeLanguage is string && data.codeLanguage.size() <= 40))
        && (!('codeSnippet' in data) || (data.codeSnippet is string && data.codeSnippet.size() <= 4000))
        && (!('publishStatus' in data) || data.publishStatus in ['published', 'upcoming'])
        && (!('scheduledDate' in data) || (data.scheduledDate is string && data.scheduledDate.size() <= 40))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovieItem(data, movieId) {
      return data.keys().hasAll([
          'movieId', 'title', 'category', 'releaseYear', 'durationLabel',
          'qualityLabel', 'fileSizeLabel', 'synopsis', 'posterUrl',
          'videoUrl', 'published', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'movieId', 'title', 'category', 'genre', 'language', 'vjTranslator',
          'releaseYear', 'durationLabel', 'qualityLabel', 'fileSizeLabel',
          'synopsis', 'posterUrl', 'coverArtUrl', 'videoUrl', 'downloadUrl',
          'published', 'createdAt', 'updatedAt'
        ])
        && data.movieId is string && isValidId(data.movieId) && data.movieId == movieId
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.category in ['Open Classics', 'Indie & Regional', 'Tech Documentaries', 'Short Films']
        && (!('genre' in data) || (data.genre is string && data.genre.size() >= 2 && data.genre.size() <= 60))
        && (!('language' in data) || (data.language is string && data.language.size() <= 60))
        && (!('vjTranslator' in data) || (data.vjTranslator is string && data.vjTranslator.size() <= 80))
        && data.releaseYear is string && data.releaseYear.size() >= 4 && data.releaseYear.size() <= 12
        && data.durationLabel is string && data.durationLabel.size() >= 2 && data.durationLabel.size() <= 30
        && data.qualityLabel in ['480p Lite', '720p HD', '1080p Full HD']
        && data.fileSizeLabel is string && data.fileSizeLabel.size() >= 2 && data.fileSizeLabel.size() <= 30
        && data.synopsis is string && data.synopsis.size() >= 10 && data.synopsis.size() <= 800
        && data.posterUrl is string && data.posterUrl.size() >= 4 && data.posterUrl.size() <= 500
        && data.posterUrl.matches('^(https://.*|/src/assets/images/.*)$')
        && (!('coverArtUrl' in data) || (
          data.coverArtUrl is string
          && data.coverArtUrl.size() >= 4
          && data.coverArtUrl.size() <= 500
          && data.coverArtUrl.matches('^(https://.*|/src/assets/images/.*)$')
        ))
        && data.videoUrl is string && data.videoUrl.size() >= 8 && data.videoUrl.size() <= 1000
        && data.videoUrl.matches('^https://.*')
        && (!('downloadUrl' in data) || (
          data.downloadUrl is string
          && data.downloadUrl.size() >= 8
          && data.downloadUrl.size() <= 1000
          && data.downloadUrl.matches('^https://.*')
        ))
        && data.published is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovieSubscriber(data, subscriberId) {
      return data.keys().hasAll([
          'subscriberId', 'subscriberUid', 'email', 'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'subscriberId', 'subscriberUid', 'email', 'subscriberName', 'active', 'createdAt', 'updatedAt'
        ])
        && data.subscriberId is string && isValidId(data.subscriberId) && data.subscriberId == subscriberId
        && data.subscriberUid is string && isValidId(data.subscriberUid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && (!('subscriberName' in data) || (data.subscriberName is string && data.subscriberName.size() <= 100))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchlistItem(data, userId, movieId) {
      return data.keys().hasAll([
          'movieId', 'userId', 'title', 'posterUrl', 'genre', 'releaseYear', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'movieId', 'userId', 'title', 'posterUrl', 'genre', 'releaseYear', 'vjTranslator', 'createdAt', 'updatedAt'
        ])
        && data.movieId is string && isValidId(data.movieId) && data.movieId == movieId
        && data.userId is string && isValidId(data.userId) && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.posterUrl is string && data.posterUrl.size() >= 4 && data.posterUrl.size() <= 500
        && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 60
        && data.releaseYear is string && data.releaseYear.size() >= 4 && data.releaseYear.size() <= 12
        && (!('vjTranslator' in data) || (data.vjTranslator is string && data.vjTranslator.size() <= 80))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWatchProgress(data, userId, movieId) {
      return data.keys().hasAll([
          'movieId', 'userId', 'title', 'posterUrl', 'positionSeconds',
          'durationSeconds', 'progressPercent', 'completed', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'movieId', 'userId', 'title', 'posterUrl', 'positionSeconds',
          'durationSeconds', 'progressPercent', 'completed', 'createdAt', 'updatedAt'
        ])
        && data.movieId is string && isValidId(data.movieId) && data.movieId == movieId
        && data.userId is string && isValidId(data.userId) && data.userId == userId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.posterUrl is string && data.posterUrl.size() >= 4 && data.posterUrl.size() <= 500
        && data.positionSeconds is int && data.positionSeconds >= 0 && data.positionSeconds <= 86400
        && data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 86400
        && data.progressPercent is int && data.progressPercent >= 0 && data.progressPercent <= 100
        && data.completed is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserEngagement(data, userId) {
      return data.keys().hasAll([
          'uid', 'streakDays', 'lastActiveDay', 'lastSeenCatalogMs', 'totalMoviesWatched', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'streakDays', 'lastActiveDay', 'lastSeenCatalogMs', 'totalMoviesWatched', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && isValidId(data.uid) && data.uid == userId
        && data.streakDays is int && data.streakDays >= 1 && data.streakDays <= 36500
        && data.lastActiveDay is string && data.lastActiveDay.size() == 10
        && data.lastActiveDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.lastSeenCatalogMs is int && data.lastSeenCatalogMs >= 0 && data.lastSeenCatalogMs <= 9999999999999
        && data.totalMoviesWatched is int && data.totalMoviesWatched >= 0 && data.totalMoviesWatched <= 100000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovieRequest(data, requestId) {
      return data.keys().hasAll([
          'requestId', 'authorId', 'authorName', 'title', 'vjPreference',
          'status', 'upvoteCount', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'authorId', 'authorName', 'title', 'vjPreference',
          'releaseYear', 'notes', 'status', 'fulfilledMovieId', 'upvoteCount', 'createdAt', 'updatedAt'
        ])
        && data.requestId is string && isValidId(data.requestId) && data.requestId == requestId
        && data.authorId is string && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.vjPreference is string && data.vjPreference.size() >= 1 && data.vjPreference.size() <= 80
        && (!('releaseYear' in data) || (data.releaseYear is string && data.releaseYear.size() <= 12))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 300))
        && data.status in ['open', 'fulfilled']
        && (!('fulfilledMovieId' in data) || (data.fulfilledMovieId is string && data.fulfilledMovieId.size() <= 128))
        && data.upvoteCount is int && data.upvoteCount >= 0 && data.upvoteCount <= 1000000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovieRequestVote(data, voteId) {
      return data.keys().hasAll([
          'voteId', 'requestId', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'voteId', 'requestId', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.voteId is string && isValidId(data.voteId) && data.voteId == voteId
        && data.requestId is string && isValidId(data.requestId)
        && data.userId is string && isValidId(data.userId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserRewards(data, userId) {
      return data.keys().hasAll([
          'uid', 'devCredits', 'lifetimeCredits', 'streakDays', 'longestStreak',
          'lastClaimDay', 'totalClaims', 'unlockedResourceIds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'devCredits', 'lifetimeCredits', 'streakDays', 'longestStreak',
          'lastClaimDay', 'totalClaims', 'unlockedResourceIds',
          'referralsCount', 'referralCreditsEarned', 'inviteeBonusApplied', 'lastClaimedReferralId',
          'createdAt', 'updatedAt'
        ])
        && data.uid is string && isValidId(data.uid) && data.uid == userId && data.uid == request.auth.uid
        && data.devCredits is int && data.devCredits >= 0 && data.devCredits <= 1000000
        && data.lifetimeCredits is int && data.lifetimeCredits >= 0 && data.lifetimeCredits <= 1000000
        && data.streakDays is int && data.streakDays >= 0 && data.streakDays <= 36500
        && data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 36500
        && data.lastClaimDay is string && data.lastClaimDay.size() == 10
        && data.lastClaimDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.totalClaims is int && data.totalClaims >= 0 && data.totalClaims <= 36500
        && data.unlockedResourceIds is list
        && data.unlockedResourceIds.size() <= 30
        && (data.unlockedResourceIds.size() == 0 || (
          data.unlockedResourceIds[0] is string && data.unlockedResourceIds[0].size() <= 64
        ))
        && (!('referralsCount' in data) || (
          data.referralsCount is int && data.referralsCount >= 0 && data.referralsCount <= 10000
        ))
        && (!('referralCreditsEarned' in data) || (
          data.referralCreditsEarned is int && data.referralCreditsEarned >= 0 && data.referralCreditsEarned <= 1000000
        ))
        && (!('inviteeBonusApplied' in data) || data.inviteeBonusApplied is bool)
        && (!('lastClaimedReferralId' in data) || (
          data.lastClaimedReferralId is string && data.lastClaimedReferralId.size() <= 128
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserNotificationState(data, userId) {
      return data.keys().hasAll([
          'uid', 'readIds', 'lastCheckedMs', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'readIds', 'lastCheckedMs', 'createdAt', 'updatedAt'
        ])
        && data.uid is string && isValidId(data.uid) && data.uid == userId && data.uid == request.auth.uid
        && data.readIds is list
        && data.readIds.size() <= 200
        && (data.readIds.size() == 0 || (
          data.readIds[0] is string && data.readIds[0].size() <= 160
        ))
        && data.lastCheckedMs is int && data.lastCheckedMs >= 0 && data.lastCheckedMs <= 9999999999999
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralCode(data, code) {
      return data.keys().hasAll([
          'code', 'ownerUid', 'ownerDisplayName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'code', 'ownerUid', 'ownerDisplayName', 'createdAt', 'updatedAt'
        ])
        && isValidReferralCodeFormat(data.code)
        && data.code == code
        && data.ownerUid is string && isValidId(data.ownerUid)
        && data.ownerDisplayName is string
        && data.ownerDisplayName.size() >= 1 && data.ownerDisplayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReferralRecord(data, referralId) {
      return data.keys().hasAll([
          'referralId', 'referralCode', 'referrerUid', 'referrerName',
          'inviteeUid', 'inviteeName', 'inviteeBonusCredits', 'referrerBonusCredits',
          'inviteeBonusClaimed', 'referrerBonusClaimed', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'referralId', 'referralCode', 'referrerUid', 'referrerName',
          'inviteeUid', 'inviteeName', 'inviteeBonusCredits', 'referrerBonusCredits',
          'inviteeBonusClaimed', 'referrerBonusClaimed', 'status', 'createdAt', 'updatedAt'
        ])
        && data.referralId is string && isValidId(data.referralId) && data.referralId == referralId
        && isValidReferralCodeFormat(data.referralCode)
        && data.referrerUid is string && isValidId(data.referrerUid)
        && data.referrerName is string
        && data.referrerName.size() >= 1 && data.referrerName.size() <= 100
        && data.inviteeUid is string && isValidId(data.inviteeUid)
        && data.inviteeName is string
        && data.inviteeName.size() >= 1 && data.inviteeName.size() <= 100
        && data.referrerUid != data.inviteeUid
        && data.inviteeBonusCredits == 50
        && data.referrerBonusCredits == 100
        && data.inviteeBonusClaimed is bool
        && data.referrerBonusClaimed is bool
        && data.status in ['verified', 'rewarded']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Rules
    // -------------------------------------------------------------------------
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isOwner(adminId);
      allow list, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isPrimaryAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserPublic(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'bio', 'updatedAt'])
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if false;

      match /private/info {
        allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'country', 'phone', 'preferredChannel', 'projectUpdatesOptIn', 'marketingOptIn', 'updatedAt'
          ])
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;

        allow delete: if false;
      }

      match /watchlist/{movieId} {
        allow get: if isValidId(userId) && isValidId(movieId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId)
          && isValidWatchlistItem(incoming(), userId, movieId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if false;

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId);
      }

      match /watchProgress/{movieId} {
        allow get: if isValidId(userId) && isValidId(movieId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId) && resource.data.userId == request.auth.uid;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId)
          && isValidWatchProgress(incoming(), userId, movieId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId)
          && isValidWatchProgress(incoming(), userId, movieId)
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'posterUrl', 'positionSeconds', 'durationSeconds', 'progressPercent', 'completed', 'updatedAt'
          ]);

        allow delete: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(movieId)
          && isOwner(userId);
      }

      match /preferences/engagement {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserEngagement(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserEngagement(incoming(), userId)
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'streakDays', 'lastActiveDay', 'lastSeenCatalogMs', 'totalMoviesWatched', 'updatedAt'
          ]);

        allow delete: if false;
      }

      match /preferences/rewards {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserRewards(incoming(), userId)
          && incoming().unlockedResourceIds.size() == 0
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            // Mode 1: Day 1 daily check-in creation
            (
              incoming().streakDays == 1
              && incoming().longestStreak == 1
              && incoming().totalClaims == 1
              && incoming().lastClaimDay != '1970-01-01'
              && incoming().devCredits == 25
              && incoming().lifetimeCredits == 25
              && (!('referralsCount' in incoming()) || incoming().referralsCount == 0)
              && (!('referralCreditsEarned' in incoming()) || incoming().referralCreditsEarned == 0)
              && (!('inviteeBonusApplied' in incoming()) || incoming().inviteeBonusApplied == false)
              && (!('lastClaimedReferralId' in incoming()) || incoming().lastClaimedReferralId == '')
            ) ||
            // Mode 2: Invitee +50 DevCredits referral welcome bonus on fresh account
            (
              incoming().streakDays == 0
              && incoming().longestStreak == 0
              && incoming().totalClaims == 0
              && incoming().lastClaimDay == '1970-01-01'
              && incoming().devCredits == 50
              && incoming().lifetimeCredits == 50
              && (!('referralsCount' in incoming()) || incoming().referralsCount == 0)
              && (!('referralCreditsEarned' in incoming()) || incoming().referralCreditsEarned == 0)
              && incoming().inviteeBonusApplied == true
              && (!('lastClaimedReferralId' in incoming()) || incoming().lastClaimedReferralId == '')
              && !exists(/databases/$(database)/documents/referrals/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.inviteeUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.updatedAt == request.time
            ) ||
            // Mode 3: Referrer +100 DevCredits first verified referral payout
            (
              incoming().streakDays == 0
              && incoming().longestStreak == 0
              && incoming().totalClaims == 0
              && incoming().lastClaimDay == '1970-01-01'
              && incoming().devCredits == 100
              && incoming().lifetimeCredits == 100
              && incoming().referralsCount == 1
              && incoming().referralCreditsEarned == 100
              && (!('inviteeBonusApplied' in incoming()) || incoming().inviteeBonusApplied == false)
              && ('lastClaimedReferralId' in incoming())
              && incoming().lastClaimedReferralId is string
              && incoming().lastClaimedReferralId.size() >= 1
              && exists(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId))
              && get(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerUid == request.auth.uid
              && get(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerBonusClaimed == false
              && getAfter(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerBonusClaimed == true
              && getAfter(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.updatedAt == request.time
            )
          );

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserRewards(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'devCredits', 'lifetimeCredits', 'streakDays', 'longestStreak',
            'lastClaimDay', 'totalClaims', 'unlockedResourceIds',
            'referralsCount', 'referralCreditsEarned', 'inviteeBonusApplied',
            'lastClaimedReferralId', 'updatedAt'
          ])
          && (
            // Action A: Daily consecutive / return check-in claim
            (
              incoming().lastClaimDay != existing().lastClaimDay
              && incoming().lastClaimDay != '1970-01-01'
              && incoming().totalClaims == existing().totalClaims + 1
              && (incoming().streakDays == 1 || incoming().streakDays == existing().streakDays + 1)
              && incoming().longestStreak >= existing().longestStreak
              && incoming().longestStreak <= existing().longestStreak + 1
              && incoming().longestStreak >= incoming().streakDays
              && incoming().lifetimeCredits > existing().lifetimeCredits
              && incoming().lifetimeCredits <= existing().lifetimeCredits + 200
              && (incoming().devCredits - existing().devCredits) == (incoming().lifetimeCredits - existing().lifetimeCredits)
              && incoming().unlockedResourceIds.size() >= existing().unlockedResourceIds.size()
              && incoming().unlockedResourceIds.size() <= existing().unlockedResourceIds.size() + 1
              && (!('referralsCount' in incoming()) || incoming().referralsCount == existingReferralsCount())
              && (!('referralCreditsEarned' in incoming()) || incoming().referralCreditsEarned == existingReferralCreditsEarned())
              && (!('inviteeBonusApplied' in incoming()) || incoming().inviteeBonusApplied == existingInviteeBonusApplied())
              && (!('lastClaimedReferralId' in incoming()) || incoming().lastClaimedReferralId == existingLastClaimedReferralId())
            ) ||
            // Action B: Redeem earned DevCredits for an exclusive technical resource
            (
              incoming().lastClaimDay == existing().lastClaimDay
              && incoming().totalClaims == existing().totalClaims
              && incoming().streakDays == existing().streakDays
              && incoming().longestStreak == existing().longestStreak
              && incoming().lifetimeCredits == existing().lifetimeCredits
              && incoming().devCredits < existing().devCredits
              && incoming().unlockedResourceIds.size() == existing().unlockedResourceIds.size() + 1
              && (!('referralsCount' in incoming()) || incoming().referralsCount == existingReferralsCount())
              && (!('referralCreditsEarned' in incoming()) || incoming().referralCreditsEarned == existingReferralCreditsEarned())
              && (!('inviteeBonusApplied' in incoming()) || incoming().inviteeBonusApplied == existingInviteeBonusApplied())
              && (!('lastClaimedReferralId' in incoming()) || incoming().lastClaimedReferralId == existingLastClaimedReferralId())
            ) ||
            // Action C: Apply one-time +50 DevCredits invitee welcome referral bonus
            (
              existingInviteeBonusApplied() == false
              && incoming().inviteeBonusApplied == true
              && incoming().lastClaimDay == existing().lastClaimDay
              && incoming().totalClaims == existing().totalClaims
              && incoming().streakDays == existing().streakDays
              && incoming().longestStreak == existing().longestStreak
              && incoming().unlockedResourceIds == existing().unlockedResourceIds
              && incoming().devCredits == existing().devCredits + 50
              && incoming().lifetimeCredits == existing().lifetimeCredits + 50
              && (!('referralsCount' in incoming()) || incoming().referralsCount == existingReferralsCount())
              && (!('referralCreditsEarned' in incoming()) || incoming().referralCreditsEarned == existingReferralCreditsEarned())
              && (!('lastClaimedReferralId' in incoming()) || incoming().lastClaimedReferralId == existingLastClaimedReferralId())
              && !exists(/databases/$(database)/documents/referrals/$(request.auth.uid))
              && existsAfter(/databases/$(database)/documents/referrals/$(request.auth.uid))
              && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.inviteeUid == request.auth.uid
              && getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.updatedAt == request.time
            ) ||
            // Action D: Claim +100 DevCredits verified referrer payout atomically with /referrals/{id}
            (
              incoming().lastClaimDay == existing().lastClaimDay
              && incoming().totalClaims == existing().totalClaims
              && incoming().streakDays == existing().streakDays
              && incoming().longestStreak == existing().longestStreak
              && incoming().unlockedResourceIds == existing().unlockedResourceIds
              && (!('inviteeBonusApplied' in incoming()) || incoming().inviteeBonusApplied == existingInviteeBonusApplied())
              && incoming().devCredits == existing().devCredits + 100
              && incoming().lifetimeCredits == existing().lifetimeCredits + 100
              && incoming().referralsCount == existingReferralsCount() + 1
              && incoming().referralCreditsEarned == existingReferralCreditsEarned() + 100
              && ('lastClaimedReferralId' in incoming())
              && incoming().lastClaimedReferralId is string
              && incoming().lastClaimedReferralId.size() >= 1
              && exists(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId))
              && get(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerUid == request.auth.uid
              && get(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerBonusClaimed == false
              && getAfter(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.referrerBonusClaimed == true
              && getAfter(/databases/$(database)/documents/referrals/$(incoming().lastClaimedReferralId)).data.updatedAt == request.time
            )
          );

        allow delete: if false;
      }

      match /preferences/notificationState {
        allow get: if isValidId(userId) && isOwner(userId);
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserNotificationState(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && isOwner(userId)
          && isValidUserNotificationState(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'readIds', 'lastCheckedMs', 'updatedAt'
          ]);

        allow delete: if false;
      }
    }

    match /inquiries/{inquiryId} {
      allow get: if isValidId(inquiryId) && isSignedIn() && (
        existing().authorId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || isPrimaryAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidProjectInquiry(incoming(), inquiryId)
        && incoming().authorId == request.auth.uid
        && incoming().status == 'submitted'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(inquiryId)
        && isValidProjectInquiry(incoming(), inquiryId)
        && (
          (isAdmin() && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt) ||
          (
            existing().authorId == request.auth.uid
            && existing().status != 'archived'
            && incoming().authorId == existing().authorId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['message', 'phone', 'company', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(inquiryId);

      match /milestones/{milestoneId} {
        allow get: if isValidId(inquiryId)
          && isValidId(milestoneId)
          && isSignedIn()
          && (
            isAdmin() || (
              exists(/databases/$(database)/documents/inquiries/$(inquiryId))
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId == request.auth.uid
              && existing().authorId == request.auth.uid
            )
          );

        allow list: if isSignedIn() && (
          resource.data.authorId == request.auth.uid || isPrimaryAdmin()
        );

        allow create: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(milestoneId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectMilestone(incoming(), inquiryId, milestoneId)
          && incoming().authorId == get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(milestoneId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectMilestone(incoming(), inquiryId, milestoneId)
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'phase', 'summary', 'dueDate', 'status', 'progress', 'sortOrder', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidId(inquiryId) && isValidId(milestoneId);
      }

      match /messages/{messageId} {
        allow get: if isValidId(inquiryId)
          && isValidId(messageId)
          && isSignedIn()
          && (
            isAdmin() || (
              exists(/databases/$(database)/documents/inquiries/$(inquiryId))
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId == request.auth.uid
              && existing().authorId == request.auth.uid
            )
          );

        allow list: if isSignedIn() && (
          resource.data.authorId == request.auth.uid || isPrimaryAdmin()
        );

        allow create: if isVerifiedUser()
          && isValidId(inquiryId)
          && isValidId(messageId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectMessage(incoming(), inquiryId, messageId)
          && incoming().senderId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            (isAdmin()
              && incoming().senderRole == 'admin'
              && incoming().authorId == get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId) ||
            (!isAdmin()
              && incoming().senderRole == 'client'
              && incoming().authorId == request.auth.uid
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId == request.auth.uid)
          );

        allow update: if false;
        allow delete: if isAdmin() && isValidId(inquiryId) && isValidId(messageId);
      }

      match /deliverables/{deliverableId} {
        allow get: if isValidId(inquiryId)
          && isValidId(deliverableId)
          && isSignedIn()
          && (
            isAdmin() || (
              exists(/databases/$(database)/documents/inquiries/$(inquiryId))
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId == request.auth.uid
              && existing().authorId == request.auth.uid
            )
          );

        allow list: if isSignedIn() && (
          resource.data.authorId == request.auth.uid || isPrimaryAdmin()
        );

        allow create: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(deliverableId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectDeliverable(incoming(), inquiryId, deliverableId)
          && incoming().authorId == get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(deliverableId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectDeliverable(incoming(), inquiryId, deliverableId)
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'url', 'notes', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidId(inquiryId) && isValidId(deliverableId);
      }

      match /invoices/{invoiceId} {
        allow get: if isValidId(inquiryId)
          && isValidId(invoiceId)
          && isSignedIn()
          && (
            isAdmin() || (
              exists(/databases/$(database)/documents/inquiries/$(inquiryId))
              && get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId == request.auth.uid
              && existing().authorId == request.auth.uid
            )
          );

        allow list: if isSignedIn() && (
          resource.data.authorId == request.auth.uid || isPrimaryAdmin()
        );

        allow create: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(invoiceId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectInvoice(incoming(), inquiryId, invoiceId)
          && incoming().authorId == get(/databases/$(database)/documents/inquiries/$(inquiryId)).data.authorId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidId(inquiryId)
          && isValidId(invoiceId)
          && exists(/databases/$(database)/documents/inquiries/$(inquiryId))
          && isValidProjectInvoice(incoming(), inquiryId, invoiceId)
          && incoming().authorId == existing().authorId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'phase', 'amountUsd', 'dueDate', 'status', 'paymentMethod', 'notes', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidId(inquiryId) && isValidId(invoiceId);
      }
    }

    match /bookings/{bookingId} {
      allow get: if isValidId(bookingId) && isSignedIn() && (
        existing().authorId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.authorId == request.auth.uid || isPrimaryAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidDiscoveryBooking(incoming(), bookingId)
        && incoming().authorId == request.auth.uid
        && incoming().status == 'requested'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(bookingId)
        && isValidDiscoveryBooking(incoming(), bookingId)
        && (
          (isAdmin()
            && incoming().authorId == existing().authorId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time) ||
          (existing().authorId == request.auth.uid
            && existing().status != 'completed'
            && incoming().authorId == existing().authorId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
        );

      allow delete: if isAdmin() && isValidId(bookingId);
    }

    match /portfolioProjects/{projectId} {
      allow get: if isValidId(projectId);
      allow list: if resource.data.featured in [true, false];

      allow create: if isAdmin()
        && isValidId(projectId)
        && isValidPortfolioProject(incoming(), projectId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(projectId)
        && isValidPortfolioProject(incoming(), projectId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(projectId);
    }

    match /blogPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if resource.data.featured in [true, false];

      allow create: if isAdmin()
        && isValidId(postId)
        && isValidBlogPost(incoming(), postId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(postId)
        && isValidBlogPost(incoming(), postId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'excerpt', 'category', 'authorName', 'authorRole',
          'publishedDate', 'readTimeMinutes', 'featured', 'coverImage',
          'stackTags', 'keyTakeaways', 'section1Heading', 'section1Body',
          'section2Heading', 'section2Body', 'section3Heading', 'section3Body',
          'calloutQuote', 'codeFilename', 'codeLanguage', 'codeSnippet',
          'publishStatus', 'scheduledDate', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(postId);
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (
        existing().recipientId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.recipientId == request.auth.uid || isPrimaryAdmin()
      );

      allow create: if isAdmin()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && incoming().isRead == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming(), notificationId)
        && (
          (isAdmin() && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time) ||
          (
            existing().recipientId == request.auth.uid
            && incoming().recipientId == existing().recipientId
            && incoming().createdAt == existing().createdAt
            && incoming().updatedAt == request.time
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(notificationId);
    }

    match /movies/{movieId} {
      allow get: if isValidId(movieId) && (existing().published == true || isAdmin());
      allow list: if resource.data.published == true || isPrimaryAdmin();

      allow create: if isAdmin()
        && isValidId(movieId)
        && isValidMovieItem(incoming(), movieId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(movieId)
        && isValidMovieItem(incoming(), movieId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title', 'category', 'genre', 'language', 'vjTranslator', 'releaseYear',
          'durationLabel', 'qualityLabel', 'fileSizeLabel', 'synopsis',
          'posterUrl', 'coverArtUrl', 'videoUrl', 'downloadUrl', 'published', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(movieId);
    }

    match /movieSubscribers/{subscriberId} {
      allow get: if isValidId(subscriberId) && isSignedIn() && (
        isOwner(subscriberId) || isAdmin()
      );
      allow list: if isPrimaryAdmin();

      allow create: if isVerifiedUser()
        && isValidId(subscriberId)
        && isOwner(subscriberId)
        && isValidMovieSubscriber(incoming(), subscriberId)
        && incoming().subscriberUid == request.auth.uid
        && incoming().active == true
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(subscriberId)
        && isValidMovieSubscriber(incoming(), subscriberId)
        && (isOwner(subscriberId) || isAdmin())
        && incoming().subscriberUid == existing().subscriberUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email', 'subscriberName', 'active', 'updatedAt'
        ]);

      allow delete: if isValidId(subscriberId) && (
        (isVerifiedUser() && isOwner(subscriberId)) || isAdmin()
      );
    }

    match /movieRequests/{requestId} {
      allow get: if isValidId(requestId) && isSignedIn();
      allow list: if isSignedIn() && resource.data.status in ['open', 'fulfilled'];

      allow create: if isVerifiedUser()
        && isValidId(requestId)
        && isValidMovieRequest(incoming(), requestId)
        && incoming().authorId == request.auth.uid
        && incoming().status == 'open'
        && incoming().upvoteCount == 1
        && existsAfter(/databases/$(database)/documents/movieRequestVotes/$(requestId + '_' + request.auth.uid))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(requestId)
        && isValidMovieRequest(incoming(), requestId)
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isAdmin()
            && incoming().upvoteCount == existing().upvoteCount
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'fulfilledMovieId', 'notes', 'updatedAt'
            ])
          ) ||
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['upvoteCount', 'updatedAt'])
            && (
              (
                incoming().upvoteCount == existing().upvoteCount + 1
                && !exists(/databases/$(database)/documents/movieRequestVotes/$(requestId + '_' + request.auth.uid))
                && existsAfter(/databases/$(database)/documents/movieRequestVotes/$(requestId + '_' + request.auth.uid))
              ) ||
              (
                incoming().upvoteCount == existing().upvoteCount - 1
                && incoming().upvoteCount >= 0
                && exists(/databases/$(database)/documents/movieRequestVotes/$(requestId + '_' + request.auth.uid))
                && !existsAfter(/databases/$(database)/documents/movieRequestVotes/$(requestId + '_' + request.auth.uid))
              )
            )
          )
        );

      allow delete: if isValidId(requestId) && (
        isAdmin() ||
        (isVerifiedUser() && existing().authorId == request.auth.uid && existing().status == 'open')
      );
    }

    match /movieRequestVotes/{voteId} {
      allow get: if isValidId(voteId) && isSignedIn() && (
        existing().userId == request.auth.uid || isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.userId == request.auth.uid || isPrimaryAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(voteId)
        && isValidMovieRequestVote(incoming(), voteId)
        && incoming().userId == request.auth.uid
        && voteId == (incoming().requestId + '_' + request.auth.uid)
        && existsAfter(/databases/$(database)/documents/movieRequests/$(incoming().requestId))
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if false;

      allow delete: if isVerifiedUser()
        && isValidId(voteId)
        && existing().userId == request.auth.uid;
    }

    match /referralCodes/{code} {
      allow get: if isSignedIn() && isValidReferralCodeFormat(code);
      allow list: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isPrimaryAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidReferralCodeFormat(code)
        && isValidReferralCode(incoming(), code)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidReferralCodeFormat(code)
        && existing().ownerUid == request.auth.uid
        && isValidReferralCode(incoming(), code)
        && incoming().code == existing().code
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['ownerDisplayName', 'updatedAt']);

      allow delete: if false;
    }

    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && isSignedIn() && (
        existing().referrerUid == request.auth.uid ||
        existing().inviteeUid == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn() && (
        resource.data.referrerUid == request.auth.uid ||
        resource.data.inviteeUid == request.auth.uid ||
        isPrimaryAdmin()
      );

      allow create: if isVerifiedUser()
        && isValidId(referralId)
        && referralId == request.auth.uid
        && isValidReferralRecord(incoming(), referralId)
        && incoming().inviteeUid == request.auth.uid
        && incoming().referrerUid != request.auth.uid
        && incoming().inviteeBonusClaimed == true
        && incoming().referrerBonusClaimed == false
        && incoming().status == 'verified'
        && exists(/databases/$(database)/documents/referralCodes/$(incoming().referralCode))
        && get(/databases/$(database)/documents/referralCodes/$(incoming().referralCode)).data.ownerUid == incoming().referrerUid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/rewards).data.inviteeBonusApplied == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/rewards).data.updatedAt == request.time
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(referralId)
        && existing().referrerUid == request.auth.uid
        && existing().referrerBonusClaimed == false
        && existing().status == 'verified'
        && isValidReferralRecord(incoming(), referralId)
        && incoming().referralId == existing().referralId
        && incoming().referralCode == existing().referralCode
        && incoming().referrerUid == existing().referrerUid
        && incoming().referrerName == existing().referrerName
        && incoming().inviteeUid == existing().inviteeUid
        && incoming().inviteeName == existing().inviteeName
        && incoming().inviteeBonusCredits == existing().inviteeBonusCredits
        && incoming().referrerBonusCredits == existing().referrerBonusCredits
        && incoming().inviteeBonusClaimed == existing().inviteeBonusClaimed
        && incoming().referrerBonusClaimed == true
        && incoming().status == 'rewarded'
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'referrerBonusClaimed', 'status', 'updatedAt'
        ])
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/rewards).data.lastClaimedReferralId == referralId
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/preferences/rewards).data.updatedAt == request.time;

      allow delete: if false;
    }
  }
}
